{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitPilot",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "theme": "Dark",
        "backgroundColor": "#101010",
        "zoomHotkeysEnabled": true
      }
    ]
  }
}
